PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kraviona
CLIENT_ORIGIN=http://localhost:3000

# Optional Licensed SEO Provider Credentials (Moz API v2)
# If provided, live Domain Authority, Page Authority, and Spam Score are fetched.
# If omitted, Kraviona returns a transparent unconfigured status without fake data.
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=
MOZ_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20